# Copie este arquivo para ".env" e preencha os valores.
# NUNCA commite o arquivo ".env" real (ele ja esta no .gitignore).

# ------------------------------------------------------------
# Gemini
# ------------------------------------------------------------
GEMINI_API_KEY=sua-chave-aqui
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------
# Servidor
# ------------------------------------------------------------
PORT=3000

# ------------------------------------------------------------
# Seguranca
# ------------------------------------------------------------

# Chave propria do servidor. O cliente (frontend/app) deve enviar
# essa chave no header "x-api-key" em toda requisicao.
# Se deixar em branco, o servidor so aceita requisicoes de localhost
# (adequado para uso pessoal na propria maquina, NAO para deploy publico).
NYRA_API_KEY=

# Origens do navegador autorizadas a chamar o servidor via CORS.
# Lista separada por virgula. Deixe em branco se o frontend nao
# roda em uma origem diferente do backend.
# Exemplo: CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=

# Limite de requisicoes por IP nas rotas que chamam o Gemini.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# ------------------------------------------------------------
# Emotion API (Flask, fallback local)
# ------------------------------------------------------------
EMOTION_API_URL=http://127.0.0.1:5000/analyze

# ------------------------------------------------------------
# Visao / caminhos locais
# ------------------------------------------------------------
NYRA_PYTHON_PATH=
NYRA_MEMORY_PATH=
